PORT=4000
# SQLite file (created automatically). NOT an in-memory database.
DB_PATH=./data/dealership.db
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10
# Used by `npm run seed`
ADMIN_EMAIL=admin@dealership.com
ADMIN_PASSWORD=Admin@12345
